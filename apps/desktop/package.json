{
  "name": "@gleech/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "GLEECH procedural image workstation",
  "author": "GLEECH contributors",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build && vite build --config mcp.vite.config.ts && vite build --config cli.vite.config.ts",
    "build:cli": "vite build --config cli.vite.config.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "pack:win": "electron-builder --win --dir",
    "dist:win": "electron-builder --win nsis",
    "pack:mac": "node ../../tooling/mac-native-notices.mjs && electron-builder --mac --dir",
    "dist:mac": "node ../../tooling/mac-native-notices.mjs && electron-builder --mac zip",
    "pack:linux": "node ../../tooling/linux-native-notices.mjs && electron-builder --linux --x64 --dir",
    "dist:linux": "node ../../tooling/linux-native-notices.mjs && electron-builder --linux AppImage --x64"
  },
  "dependencies": {
    "@gleech/command-service": "workspace:*",
    "@gleech/effects": "workspace:*",
    "@gleech/mcp": "workspace:*",
    "@gleech/project-model": "workspace:*",
    "@gleech/renderer-core": "workspace:*",
    "onnxruntime-node": "1.30.0",
    "onnxruntime-node-macos-x64": "npm:onnxruntime-node@1.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "vite": "7.3.7"
  },
  "license": "MIT"
}
