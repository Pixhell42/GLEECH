{
  "name": "@gleech/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "GLEECH procedural image workstation",
  "author": "GLEECH contributors",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build && vite build --config mcp.vite.config.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "pack:win": "electron-builder --win --dir",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "@gleech/command-service": "workspace:*",
    "@gleech/effects": "workspace:*",
    "@gleech/project-model": "workspace:*",
    "@gleech/renderer-core": "workspace:*",
    "onnxruntime-node": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.6",
    "@gleech/mcp": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "vite": "7.3.6"
  },
  "license": "MIT"
}
