  let ink=CLAMP((P(10)+(1-l*lighting)*0.35-hatch)/MAX(0.02,aa)+0.5,0,1);
  tone=1-ink;lighting=lighting*(0.35+tone*0.65);
 } else if(kind==4) {
  // Avoid scaling then unscaling fractal coordinates: intermediate rounding
