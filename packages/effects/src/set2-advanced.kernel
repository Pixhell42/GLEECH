function Shade(kind,u,v,px,py) {
 let phase=U(4);let seed=U(7);
 let bx=(u-U(5))*U(0);let by=(v-U(6))*U(1);
 let angle=U(22);let rotatedX=P(52)*bx-P(53)*by;
 let rotatedY=P(53)*bx+P(52)*by;
