// Original scalar material algorithms. Build into f32 CPU and WGSL with
// tooling/generate-advanced-shaders.mjs; no runtime code evaluation.
function Palette(t,ch) {
 let spectral=0.5+0.5*COS(t*6.283185+ch*2.094395+U(7));
 return MIX(MIX(U(28+ch),U(24+ch),CLAMP(t,0,1)),spectral,U(11));
}
function Hue(r,g,b,angle,ch) {
 let c=COS(angle);let s=SIN(angle);let y=0.299*r+0.587*g+0.114*b;
 let i=0.596*r-0.274*g-0.322*b;let q=0.211*r-0.523*g+0.312*b;
 let ii=i*c-q*s;let qq=i*s+q*c;
 if(ch==0)return CLAMP(y+0.956*ii+0.621*qq,0,1);
 if(ch==1)return CLAMP(y-0.272*ii-0.647*qq,0,1);
 return CLAMP(y-1.106*ii+1.703*qq,0,1);
}
function Lum(u,v) {return (T(u,v,0)*0.2126+T(u,v,1)*0.7152+T(u,v,2)*0.0722)*T(u,v,3);}
function Segment(x,y,ax,ay,bx,by) {
 let dx=bx-ax;let dy=by-ay;
 let t=CLAMP(((x-ax)*dx+(y-ay)*dy)/MAX(0.000001,dx*dx+dy*dy),0,1);
 return SQRT((x-ax-dx*t)*(x-ax-dx*t)+(y-ay-dy*t)*(y-ay-dy*t));
}
function Mandel(x,y,limit) {
 return M(x,y,limit);
}
function Safe(x) {if(ABS(x)<0.00001){if(x<0)return -0.00001;return 0.00001;}return x;}
// Analytic ray intersections: sphere, box, capped cylinder and capped cone.
function Primitive(ox,oy,oz,dx,dy,dz,r,shape) {
 if(shape==2) {
  let xa=(-r-ox)/Safe(dx);let xb=(r-ox)/Safe(dx);
  let ya=(-r-oy)/Safe(dy);let yb=(r-oy)/Safe(dy);
  let za=(-r-oz)/Safe(dz);let zb=(r-oz)/Safe(dz);
  let entry=MAX(MAX(MIN(xa,xb),MIN(ya,yb)),MIN(za,zb));
  let exit=MIN(MIN(MAX(xa,xb),MAX(ya,yb)),MAX(za,zb));
  if(exit<MAX(0,entry))return 100;return MAX(0,entry);
 }
 let a=dx*dx+dy*dy+dz*dz;let b=2*(ox*dx+oy*dy+oz*dz);let cc=ox*ox+oy*oy+oz*oz-r*r;
 if(shape==3){a=dx*dx+dz*dz;b=2*(ox*dx+oz*dz);cc=ox*ox+oz*oz-r*r;}
 if(shape==4){a=dx*dx+dz*dz-dy*dy*0.25;b=2*(ox*dx+oz*dz+(r-oy)*dy*0.25);cc=ox*ox+oz*oz-(r-oy)*(r-oy)*0.25;}
 // Move the quadratic origin close to its vertex before subtracting squared
 // terms. Distant camera origins otherwise lose precision at silhouettes.
 let shift=0;
 if(ABS(a)>0.00001) {
  // Keep the sign in the denominator: some shader optimizers mis-handle
  // negated quotients after the shape-dependent coefficient assignments.
  shift=b/(-2*a);
  let x=ox+dx*shift;let y=oy+dy*shift;let z=oz+dz*shift;
  b=2*(x*dx+y*dy+z*dz);cc=x*x+y*y+z*z-r*r;
  if(shape==3){b=2*(x*dx+z*dz);cc=x*x+z*z-r*r;}
  if(shape==4){b=2*(x*dx+z*dz+(r-y)*dy*0.25);cc=x*x+z*z-(r-y)*(r-y)*0.25;}
 }
 let disc=b*b-4*a*cc;let result=100;
 if(disc>=0&&ABS(a)>0.00001) {
  let root=SQRT(disc);let first=shift+(b+root)/(-2*a);let second=shift+(b-root)/(-2*a);
  for(let i=0;i<2;i++) {
   let t=first;if(i==1)t=second;
   if(t>=0&&(shape<3||ABS(oy+dy*t)<=r))result=MIN(result,t);
  }
 }
 if(shape>=3&&ABS(dy)>0.00001) {
  for(let i=0;i<2;i++) {
   let cap=-r;if(i==1)cap=r;
   let t=(cap-oy)/dy;let x=ox+dx*t;let z=oz+dz*t;
   let capRadius=r;if(shape==4&&i==1)capRadius=0;
   if(t>=0&&x*x+z*z<=capRadius*capRadius)result=MIN(result,t);
  }
 }
 return result;
}
function FoilDistance(x,y,z,u,v) {
 let yaw=P(5)*0.0174533;let pitch=P(12)*0.0174533;
 let rx=COS(yaw)*x-SIN(yaw)*z;let rz=SIN(yaw)*x+COS(yaw)*z;
 let ry=COS(pitch)*y-SIN(pitch)*rz;rz=SIN(pitch)*y+COS(pitch)*rz;
 let radius=P(4);let distance=SQRT(rx*rx+ry*ry+rz*rz)-radius;
 if(P(3)>0) {
  let q=SQRT(rx*rx+rz*rz)-radius*0.72;
  distance=SQRT(q*q+ry*ry)-radius*0.22;
  if(P(3)>1) {
   let q2=SQRT(ry*ry+rz*rz)-radius*0.72;
   distance=MIN(distance,SQRT(q2*q2+rx*rx)-radius*0.22);
  }
 }
 let phase=U(4);let materialX=(COS(U(22))*rx-SIN(U(22))*ry)*P(6)*U(2)/5;
 let materialY=(SIN(U(22))*rx+COS(U(22))*ry)*P(6)*U(2)/5;
 let folds=SIN(materialX*8+phase)*SIN(materialY*6-phase+U(7));
 let relief=(H(u,v)-0.5)*P(10);
 return distance+(folds*P(7)+relief)*radius*0.065;
}
// Analytic coverage of curved silhouettes. Evaluate the closest point inside
// the capped height interval, then feather over one canvas pixel.
function PrimitiveCoverage(ox,oy,oz,dx,dy,dz,r,shape,pixel) {
 if(shape==2)return 1;
 let a=dx*dx+dy*dy+dz*dz;let b=2*(ox*dx+oy*dy+oz*dz);
 if(shape==3){a=dx*dx+dz*dz;b=2*(ox*dx+oz*dz);}
 if(shape==4){a=dx*dx+dz*dz-dy*dy*0.25;b=2*(ox*dx+oz*dz+(r-oy)*dy*0.25);}
 let t=b/(-2*Safe(a));
 if(shape>=3&&ABS(dy)>0.00001) {
  let first=(-r-oy)/dy;let last=(r-oy)/dy;
  t=CLAMP(t,MIN(first,last),MAX(first,last));
  if(shape==4&&a<0) {
   let x1=ox+dx*first;let z1=oz+dz*first;let x2=ox+dx*last;let z2=oz+dz*last;
   if(x1*x1+z1*z1-r*r<x2*x2+z2*z2)t=first;else t=last;
  }
 }
 let x=ox+dx*t;let y=oy+dy*t;let z=oz+dz*t;
 let gap=SQRT(x*x+y*y+z*z)-r;
 if(shape>=3)gap=SQRT(x*x+z*z)-r;
 if(shape==4) {
  let radius=(r-y)*0.5;
  gap=(x*x+z*z-radius*radius)/MAX(0.00001,SQRT(4*x*x+4*z*z+radius*radius));
 }
 if(shape>=3&&ABS(dy)<=0.00001)gap=MAX(gap,ABS(oy)-r);
 return CLAMP(0.5-gap/MAX(0.00001,pixel),0,1);
