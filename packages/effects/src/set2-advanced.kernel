      for(let segment=1;segment<=4;segment++) {
       let t=segment/4;let bend=SIN(t*3.141593)*SIN(phase*2+R(cx,cy,segment+3)*12)*jitter*0.3;
       let endx=MIX(ax,ex,t)+bend;let endy=MIX(ay,ey,t)-bend;
       distance=MIN(distance,Segment(qx,qy,lastx,lasty,endx,endy));lastx=endx;lasty=endy;
      }
     }
     let light=EXP(-distance*distance/MAX(0.00001,width*width))+EXP(-distance*distance/(0.008+glow*0.08))*glow*0.25;
     if(kind==5)light=light*P(5)*(0.65+0.35*SIN(phase*2+qx*4+qy*3+R(cx,cy,7)*6));
     energy=MAX(energy,light);
    }
   }
  }
  coverage=CLAMP(energy,0,1);tone=N(qx*0.2+phase*0.1,qy*0.2);lighting=0.7+coverage*0.6;
 } else if(kind==6) {
  let xx=qx+SIN(qy*0.7+phase+seed)*P(3)*0.75;let column=FLOOR(xx);
  let yy=qy/P(2)+column*P(6)*0.5;let row=FLOOR(yy);
  let dx=xx-column-0.5;let dy=yy-row-0.5;
  let distance=SQRT(dx*dx+dy*dy);if(P(1)==2)distance=MAX(ABS(dx),ABS(dy));
  let radius=P(5);let extent=radius;
  if(P(1)==0){distance=ABS(distance-radius*0.75);extent=radius*P(7);}
  coverage=CLAMP((extent-distance)/aa+0.5,0,1);
  if(R(column,row,1)<P(4))coverage=0;
  tone=R(column,row,2)*0.5+SIN(phase+column*0.35)*0.25+0.25;
  if(P(1)==1)lighting=0.4+SQRT(MAX(0,1-(dx*dx+dy*dy)/(radius*radius)))*0.8;
 } else if(kind==7) {
  let r=SQRT(qx*qx+qy*qy)/3;let theta=ATAN(qy,qx);
  let brightest=0;coverage=0;
  for(let j=0;j<12;j++) {
   if(j>=P(3))break;
   let center=(j+1)/(P(3)+1)*0.45;
   let half=(0.5/(P(3)+1))*(0.6+P(5));
   let a=theta+phase*(0.1+j*0.025)+j*P(7)*0.0174533+seed*0.05;
   let sector=a*P(2)/6.283185;let cell=FLOOR(sector);let local=sector-cell;
   let radial=ABS(r-center)/MAX(0.001,half);
   let triangular=radial+ABS(local-0.5)*1.4;
   if(P(1)>0)triangular=radial+ABS(local-0.5);
   let fill=CLAMP((1-triangular)/MAX(0.01,AA()*10)+0.5,0,1);
   let facet=FLOOR(local*P(4));let edge=MIN(ABS(1-triangular),ABS(local*P(4)-FLOOR(local*P(4))));
   let ink=CLAMP((P(6)*0.15-edge)/MAX(0.005,AA()*5)+0.5,0,1);
   if(fill>brightest){brightest=fill;coverage=fill;tone=R(cell,j,2)*0.45+facet/P(4)*0.55;lighting=1-ink*0.65;}
  }
 } else {
  let normalx=0;let normaly=0;let normalz=1;
  if(P(2)>0) {
   let t=1;let nearest=100;let closest=1;
   for(let j=0;j<56;j++) {
    let z=-1.4+t;let d=FoilDistance(bx,by,z,u,v);
    if(d<nearest){nearest=d;closest=t;}
    // Use the same bounded convergence count on both backends. A hard hit
    // threshold can stop one iteration apart and change the sampled normal.
    t+=MAX(0,d*0.65);if(t>2.8)break;
   }
   // Fade grazing rays at the convergence boundary rather than switching a
   // complete pixel between a hit and a miss due to tiny arithmetic differences.
   coverage=CLAMP((0.002-nearest)/0.001,0,1);
   if(coverage>0) {
    let z=-1.4+closest;let e=0.003;
    normalx=FoilDistance(bx+e,by,z,u,v)-FoilDistance(bx-e,by,z,u,v);
    normaly=FoilDistance(bx,by+e,z,u,v)-FoilDistance(bx,by-e,z,u,v);
    normalz=FoilDistance(bx,by,z+e,u,v)-FoilDistance(bx,by,z-e,u,v);
    let norm=MAX(0.0001,SQRT(normalx*normalx+normaly*normaly+normalz*normalz));
    normalx=normalx/norm;normaly=normaly/norm;normalz=normalz/norm;
    // Continuous normal-based projection keeps the image folded into the
    // surface without an atan branch-cut seam across the visible hemisphere.
    sx=CLAMP(0.5+normalx*0.5,0,1);sy=CLAMP(0.5+normaly*0.5,0,1);
   }
  } else {
   let eps=0.004;
   let foldx=COS(qx*P(6)+phase+seed)*P(7)*1.8;
   let foldy=SIN(qy*P(6)-phase)*P(7)*1.8;
   normalx=foldx+(H(u+eps,v)-H(u-eps,v))*P(10)*30;
   normaly=foldy+(H(u,v+eps)-H(u,v-eps))*P(10)*30;
   let norm=SQRT(normalx*normalx+normaly*normaly+1);normalx=normalx/norm;normaly=normaly/norm;normalz=1/norm;
  }
  let light=P(11)*0.0174533;
  let reflection=normalx*COS(light)-normaly*SIN(light)+normalz*0.5;
  let sharpness=MIX(14,1,P(8));if(P(1)>0)sharpness=sharpness*1.8;
  let highlight=POW(CLAMP(reflection*0.5+0.5,0,1),sharpness);
  tone=CLAMP(0.5+normalx*0.3+normaly*0.2+SIN(phase+reflection*4)*0.1,0,1);
  lighting=MIX(0.65+normalz*0.25,0.15+highlight*1.8+ABS(SIN(reflection*5+phase))*0.2,P(9));
 }
 if(kind==0||kind==1) {
  let hue=P(6)*0.0174533;if(kind==1)hue=P(8)*0.0174533;
  if(hue!=0) {
   let r=MIX(Palette(tone,0),T(sx,sy,0),P(0))*lighting;
   let g=MIX(Palette(tone,1),T(sx,sy,1),P(0))*lighting;
   let b=MIX(Palette(tone,2),T(sx,sy,2),P(0))*lighting;
   for(let ch=0;ch<3;ch++)O(ch,MIX(U(28+ch),Hue(r,g,b,hue,ch),coverage));return;
  }
 }
 for(let ch=0;ch<3;ch++) {
  let material=MIX(Palette(tone,ch),T(sx,sy,ch),P(0))*lighting;
  O(ch,MIX(U(28+ch),material,coverage));
 }
}
