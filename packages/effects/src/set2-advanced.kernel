   if(j>=P(6))break;
   let xx=qx+dx*SIN(qy+j+phase)+j*0.37;
   let yy=qy+dy*COS(qx-j+phase)+j*0.61;
   let cell=FLOOR(xx);let row=FLOOR(yy*0.25);
   let r=R(cell,row,j);
