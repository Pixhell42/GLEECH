     }
     slabAlpha+=weight;
    }
    red+=slabRed*(1-coverage);green+=slabGreen*(1-coverage);blue+=slabBlue*(1-coverage);
    coverage+=slabAlpha*(1-coverage);
   }
   O(0,U(28)*(1-coverage)+red);O(1,U(29)*(1-coverage)+green);O(2,U(30)*(1-coverage)+blue);return;
  }
  tone=Mandel(fx,fy,P(10));
