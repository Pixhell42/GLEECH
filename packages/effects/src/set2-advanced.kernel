  tone=CLAMP(theta/MAX(0.01,half)*0.5+0.5+grating*0.15,0,1);
  lighting=1.2;
 } else if(kind==5||kind==8) {
  let cellx=FLOOR(qx);let celly=FLOOR(qy);
  let energy=0;let reach=P(3);let width=P(7);let glow=P(6);let jitter=P(4);
  if(kind==8){width=P(5);glow=P(6);jitter=P(7);}
