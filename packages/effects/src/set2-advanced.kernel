     nearest=t;coverage=silhouette;
     let hx=lx+vx*t;let hy=y+dy*t;let hz=lz+vz*t;
     nx=hx/size;ny=hy/size;nz=hz/size;
     if(shape==2){let m=MAX(MAX(ABS(hx),ABS(hy)),ABS(hz));nx=0;ny=0;nz=0;if(ABS(hx)>=m-0.0001)nx=SIGN(hx);else if(ABS(hy)>=m-0.0001)ny=SIGN(hy);else nz=SIGN(hz);}
     if(shape>=3){if(ABS(ABS(hy)-size)<0.001){nx=0;nz=0;ny=SIGN(hy);}else{ny=0;if(shape==4)ny=0.5;}}
     let normalX=COS(rot)*nx+SIN(rot)*nz;let normalZ=-SIN(rot)*nx+COS(rot)*nz;
     nx=normalX;nz=normalZ;
     sx=CLAMP(0.5+hx/(size*3),0,1);sy=CLAMP(0.5+hy/(size*3),0,1);
     l=0.5+hy/(size*4);
    }
   }
  } else {nx=(Lum(u+0.005,v)-Lum(u-0.005,v))*10;ny=(Lum(u,v+0.005)-Lum(u,v-0.005))*10;}
  let light=P(12)*0.0174533;
