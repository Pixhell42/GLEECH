     let t=MIX(start,end,k/3);let x=ox+dx*t;let y=oy+dy*t;
     let box=CLAMP((0.56-MAX(ABS(x),ABS(y)))/MAX(0.00001,AA())+0.5,0,1);
     if(t<0||box==0)continue;
     let mx=P(20+j*2)+(P(52)*x-P(53)*y)*3/P(7);
