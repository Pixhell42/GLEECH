     let paletteTone=CLAMP(0.5+band*0.5,0,1);
     let light=MIX(1,CLAMP(1-(z+(P(3)-1)*P(5)*0.5)*0.9,0.25,1),P(13));
     for(let ch=0;ch<3;ch++) {
      let value=T(tx,ty,ch);
