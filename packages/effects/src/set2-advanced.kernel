  if(P(2)>0) {
   let yaw=P(8)*0.0174533;let pitch=P(9)*0.0174533;
   let rox=COS(yaw)*bx-SIN(yaw)*(-3);
   let rz=SIN(yaw)*bx+COS(yaw)*(-3);
   let roy=COS(pitch)*by-SIN(pitch)*rz;let roz=SIN(pitch)*by+COS(pitch)*rz;
   let dx=-SIN(yaw);let dz=COS(yaw);let dy=-SIN(pitch)*dz;dz=COS(pitch)*dz;
   let nearest=100;coverage=0;
   for(let j=0;j<12;j++) {
    if(j>=P(4))break;
    let cx=(R(j,0,1)-0.5)*P(6)*P(13);let cy=(R(j,0,2)-0.5)*P(6)*P(14);let cz=(R(j,0,3)-0.5)*P(6)*0.5;
    let rot=P(7)*0.0174533+phase+R(j,0,4)*2;
