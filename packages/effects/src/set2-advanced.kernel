 let aa=MAX(0.001,AA()*U(2));
 let tone=0;let coverage=1;let sx=u;let sy=v;let lighting=1;
 if(kind==0) {
  let grid=P(4);let ux=FLOOR(u/grid)*grid+grid*0.5;let uy=FLOOR(v/grid)*grid+grid*0.5;
  let wx=SIN(qy+phase+N(qx,qy)*6)*P(3)*0.12;
  let wy=COS(qx-phase+seed)*P(3)*0.12;
