    let nodeDistance=SQRT((qx-ax)*(qx-ax)+(qy-ay)*(qy-ay));
    energy=MAX(energy,EXP(-nodeDistance*nodeDistance/MAX(0.0001,width*width*6)));
    for(let branch=0;branch<4;branch++) {
     let nx=cx+1;let ny=cy;
     if(branch==1){nx=cx;ny=cy+1;}if(branch==2){nx=cx+1;ny=cy+1;}if(branch==3){nx=cx-1;ny=cy+1;}
     if(R(nx,ny,0)>gate)continue;
     let ex=nx+0.5+SIN(phase+R(nx,ny,1)*6.283185)*jitter*0.28;
     let ey=ny+0.5+COS(phase+R(nx,ny,2)*6.283185)*jitter*0.28;
