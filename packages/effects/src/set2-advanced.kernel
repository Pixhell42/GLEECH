  let wave=SIN(bands*6.283185+phase+seed);
  coverage=CLAMP((wave-(1-P(5)*2))/MAX(0.03,aa)+0.5,0,1);
  tone=height;if(P(1)>0)tone=FLOOR(height*P(2))/P(2);
  sx=ux+wx;sy=uy+wy;
 } else if(kind==1) {
